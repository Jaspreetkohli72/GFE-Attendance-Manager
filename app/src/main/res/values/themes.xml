<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GFEAttendanceManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/color_clock</item>
        <item name="colorPrimaryVariant">@color/bg_card</item>
        <item name="colorOnPrimary">@color/bg_main</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/color_clock_in_stroke</item>
        <item name="colorSecondaryVariant">@color/color_clock_in_bg</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>
</resources>
