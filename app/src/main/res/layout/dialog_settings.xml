<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/bg_card_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- PIN Authentication Gate Layout -->
        <LinearLayout
            android:id="@+id/layoutPinGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_security_gate"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enter_admin_pin"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <!-- PIN Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/hint_admin_pin"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_main"
                app:boxStrokeColor="@color/accent_blue"
                app:hintTextColor="@color/accent_blue"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error Message Text -->
            <TextView
                android:id="@+id/tvPinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/incorrect_pin"
                android:textColor="@color/color_clock_out_btn"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Submit PIN Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/submit_pin"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/accent_blue" />

            <!-- Cancel Button for PIN Gate -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPinCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/cancel"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="@color/color_clock_out_stroke"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Admin Controls Layout (Shown after valid PIN) -->
        <LinearLayout
            android:id="@+id/layoutAdminControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_settings"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/configure_server_url"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <!-- Server Base URL Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/hint_server_url"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_main"
                app:boxStrokeColor="@color/color_clock_in_stroke"
                app:hintTextColor="@color/color_clock_in_stroke"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- SAVE URL Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveUrl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/save_url"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/color_clock_in_stroke" />

            <!-- EXIT KIOSK / OPEN SYSTEM SETTINGS Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/exit_kiosk_system_settings"
                android:textColor="@color/color_advance"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="@color/color_advance"
                app:cornerRadius="12dp" />

            <!-- Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/close"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="@color/color_clock_out_stroke"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
