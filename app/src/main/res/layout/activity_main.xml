<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- Top Header Bar Container (64dp height) -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/bg_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <!-- Workshop Title (20sp bold #F8FAFC) -->
            <TextView
                android:id="@+id/tvWorkshopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workshop_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Digital Clock (20sp bold Cyan #38BDF8) -->
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:textColor="@color/color_clock"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="10:45:12 AM" />

            <!-- Spacer pushing right controls -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Sync Status Badge Pill Container -->
            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pill_synced"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/color_clock_in_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="● Synced" />

            <!-- Refresh Circular Icon Button -->
            <ImageButton
                android:id="@+id/ibRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_refresh"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                app:tint="@color/color_clock_out_text" />

            <!-- Settings Circular Icon Button -->
            <ImageButton
                android:id="@+id/ibSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/color_clock_out_text" />

        </LinearLayout>

        <!-- Bottom divider stroke #334155 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/bg_card_stroke" />

    </FrameLayout>

    <!-- Background Watermark Emblem -->
    <ImageView
        android:id="@+id/ivBackgroundWatermark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="32dp"
        android:alpha="0.06"
        android:scaleType="centerInside"
        android:src="@drawable/ic_kiosk_watermark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        tools:ignore="ContentDescription" />

    <!-- Main Content Body: SwipeRefreshLayout containing RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStaffGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:spanCount="3"
            tools:listitem="@layout/item_staff_button" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Confirmation Overlay Banner (Rounded Pill Banner, 12dp corner radius, 8dp elevation, 20sp bold text) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvConfirmationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/color_clock_in_stroke"
        app:cardBackgroundColor="@color/color_clock_in_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvConfirmationBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="14dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="PUNCH SUCCESSFUL" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
